{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,   // ALTERADO para false
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": false,                 // ALTERADO para false
    "noUnusedLocals": false,         // ALTERADO para false
    "noUnusedParameters": false,     // ALTERADO para false
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    /* Suporte a importações com @/ */
    "baseUrl": "src",
    "paths": {
      "@/*": ["*"]
    }
  },
  "include": ["vite.config.ts"]
}
